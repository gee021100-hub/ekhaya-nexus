# ------------------------------------------------------------------
# EKHAYA APP - Environment Variables
# Copy to .env.local and fill in. Never commit real secrets.
# ------------------------------------------------------------------

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3100
APP_NAME=EKHAYA APP

# --- Payments ---
# sandbox (default): payments auto-confirm for demonstration only.
# manual: fan payments stay pending until staff verify the wallet reference
# in /admin/payments (recommended for production).
# A real mobile-money/online provider can be added behind the same RPCs later.
PAYMENT_MODE=sandbox

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Email (transactional) ---
# Fan emails (bookings, memberships, contact) are sent with Resend when a key
# is present and silently skipped when it isn't, so the app works without it.
RESEND_API_KEY=
EMAIL_FROM=Ekhaya FC <fans@ekhayafc.app>

# --- Error tracking (Sentry) ---
# When set, the app forwards server + client exceptions to Sentry. The DSN is
# published to the browser, so the NEXT_PUBLIC variant is public by design.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# --- Uptime monitoring ---
# Public liveness probes (no env vars required):
#   /healthz        - app is up
#   /healthz/db     - 503 when the Supabase database is unreachable
# Point UptimeRobot / Uptime Kuma at the public HTTPS URLs for the tunnel or
# the production domain.