{
  "name": "ekhaya-app",
  "version": "1.0.0",
  "private": true,
  "description": "EKHAYA APP - Football team management and statistics for Ekhaya FC",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3100",
    "dev:lan": "next dev -H 0.0.0.0 -p 3100",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p ${PORT:-3100}",
    "start:lan": "next start -H 0.0.0.0 -p 3100",
    "icons": "node scripts/generate-icons.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:migrate": "supabase db push",
    "db:seed": "supabase db reset",
    "db:types": "supabase gen types typescript --local > types/database.ts"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.75.0",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.49.1",
    "clsx": "^2.1.1",
    "geist": "^1.7.2",
    "next": "^15.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@netlify/plugin-nextjs": "^5.16.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.21.0",
    "eslint-config-next": "^15.2.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0"
  }
}
